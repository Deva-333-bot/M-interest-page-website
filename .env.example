# Copy to .env for local use (never commit .env). Names only - no real secrets here.
NODE_ENV=development
PORT=3000
# PostgreSQL connection string. Local example:  postgres://postgres:password@localhost:5432/minterest
DATABASE_URL=
# auto (default) | off | require | verify.  auto = no TLS for localhost / Render-internal hosts, TLS otherwise.
DATABASE_SSL=auto
# Public https URL of the site, no trailing slash (canonical URLs, sitemap). Must be https in production.
SITE_URL=http://localhost:3000
# Required in production: 32+ random characters (openssl rand -base64 48)
SESSION_SECRET=
# Optional: 24+ random characters. Enables the one-time /admin/setup page while no admin exists.
# Remove it after the first owner account is created.
SETUP_TOKEN=
# Set to 1 behind a reverse proxy / PaaS load balancer (Render) so rate limiting sees real client IPs
TRUST_PROXY=
